    1              0.000001 function! s:closematch(str) " {{{1
                              " Close an open (, {, [, or < on the command line.
                              let tail = matchstr(a:str,'.[^\[\](){}<>]*$')
                              if tail =~ '^\[.\+'
                                return "]"
                              elseif tail =~ '^(.\+'
                                return ")"
                              elseif tail =~ '^{.\+'
                                return "}"
                              elseif tail =~ '^<.+'
