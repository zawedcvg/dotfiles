                            " Logcheck
                            au BufNewFile,BufRead */etc/logcheck/*.d*/*	call s:StarSetf('logcheck')
                            
                            " Makefile
                            au BufNewFile,BufRead [mM]akefile*		call s:StarSetf('make')
                            
