                            endfunction
                            
    1              0.000001 function! s:string_decode(str) abort
                              let map = {'n': "\n", 'r': "\r", 't': "\t", 'b': "\b", 'f': "\f", 'e': "\e", 'a': "\001", 'v': "\013", "\n": ''}
